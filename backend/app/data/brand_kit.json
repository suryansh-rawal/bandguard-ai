{
  "brand": {
    "name": "BrandGuard AI",
    "version": "1.2.0",
    "last_updated": "2026-10-22",
    "tagline": "The Enterprise Guardrail for Brand Safety & Factual Integrity",
    "tone_principles": [
      {
        "id": "TONE-01",
        "name": "Empowering & Professional",
        "description": "Speak with confidence, clarity, and authority without sounding pretentious, arrogant, or dismissive."
      },
      {
        "id": "TONE-02",
        "name": "Factual & Evidentiary",
        "description": "Never make unverified promises, absolute guarantees, or hyperbole. Every claim must trace directly to the Fact Vault."
      },
      {
        "id": "TONE-03",
        "name": "Transparent & Precise",
        "description": "Use accurate technical terminology; avoid vague buzzwords ('revolutionary magic', 'unbeatable')."
      }
    ]
  },
  "glossary": {
    "banned_terms": [
      {
        "id": "BAN-001",
        "term": "guaranteed 100% uptime",
        "patterns": ["guarantee(?:d|s|ing)? 100% uptime", "100% uptime guarantee(?:d|s)?"],
        "alternatives": ["99.95% monthly uptime SLA backed by credits"],
        "reason": "Absolute availability guarantees violate SLA compliance policy and legal liability frameworks.",
        "severity": "critical",
        "source": "Brand Kit - Glossary v1.2",
        "category": "compliance"
      },
      {
        "id": "BAN-002",
        "term": "unhackable",
        "patterns": ["unhackable", "un-hackable", "immune to (?:all )?hack(?:er)?s"],
        "alternatives": ["enterprise-grade security with defense-in-depth architecture"],
        "reason": "Absolute security claims are technically inaccurate and create legal exposure.",
        "severity": "critical",
        "source": "Brand Kit - Glossary v1.2",
        "category": "security"
      },
      {
        "id": "BAN-003",
        "term": "cheap",
        "patterns": ["\\bcheap\\b", "\\bcheapest\\b"],
        "alternatives": ["cost-effective", "economical", "high ROI"],
        "reason": "The word 'cheap' devalues the perceived quality of enterprise software.",
        "severity": "suggestion",
        "source": "Brand Kit - Glossary v1.2",
        "category": "tone"
      },
      {
        "id": "BAN-004",
        "term": "revolutionary magic",
        "patterns": ["revolutionary magic", "magic(?:al)? AI", "works like magic"],
        "alternatives": ["advanced machine learning models", "cutting-edge algorithmic architecture"],
        "reason": "Unscientific hyperbole diminishes credibility in enterprise sales.",
        "severity": "warning",
        "source": "Brand Kit - Glossary v1.2",
        "category": "tone"
      },
      {
        "id": "BAN-005",
        "term": "foolproof",
        "patterns": ["\\bfoolproof\\b", "\\bfool-proof\\b"],
        "alternatives": ["intuitive and error-resilient", "robust"],
        "reason": "Considered patronizing to users and an unverifiable assertion of zero error.",
        "severity": "warning",
        "source": "Brand Kit - Glossary v1.2",
        "category": "tone"
      },
      {
        "id": "BAN-006",
        "term": "infinite scalability",
        "patterns": ["infinite(?:ly)? scalab(?:ility|le)", "unlimited scale"],
        "alternatives": ["elastic multi-region cloud scaling"],
        "reason": "Physics and cloud provider quotas prevent infinite resources; state exact capacity capabilities.",
        "severity": "warning",
        "source": "Brand Kit - Glossary v1.2",
        "category": "technical"
      },
      {
        "id": "BAN-007",
        "term": "completely risk-free",
        "patterns": ["completely risk-free", "zero risk", "100% risk free"],
        "alternatives": ["backed by our 30-day enterprise evaluation agreement"],
        "reason": "Legally prohibited absolute warranty.",
        "severity": "critical",
        "source": "Brand Kit - Glossary v1.2",
        "category": "legal"
      },
      {
        "id": "BAN-008",
        "term": "zero latency",
        "patterns": ["zero latency", "0 latency", "no latency"],
        "alternatives": ["ultra-low sub-50ms average latency"],
        "reason": "Zero latency is physically impossible in distributed network topologies.",
        "severity": "critical",
        "source": "Brand Kit - Glossary v1.2",
        "category": "technical"
      },
      {
        "id": "BAN-009",
        "term": "never fails",
        "patterns": ["never fails?", "fail-proof", "cannot fail"],
        "alternatives": ["engineered for high fault tolerance and automated failover"],
        "reason": "Unverifiable absolute reliability claim that breaches SLA compliance guidelines.",
        "severity": "critical",
        "source": "Brand Kit - Glossary v1.2",
        "category": "reliability"
      },
      {
        "id": "BAN-010",
        "term": "unbeatable",
        "patterns": ["\\bunbeatable\\b"],
        "alternatives": ["industry-leading", "benchmark-topping"],
        "reason": "Subjective superlative without certified comparison basis.",
        "severity": "warning",
        "source": "Brand Kit - Glossary v1.2",
        "category": "tone"
      },
      {
        "id": "BAN-011",
        "term": "guarantee 100% success",
        "patterns": ["(?:[Gg]uarantee(?:d|s|ing)? )?100% (?:success|satisfaction|results?)", "[Gg]uarantee(?:d|s|ing)? (?:success|results?)"],
        "alternatives": ["help you work towards your goals"],
        "reason": "Guarantees and absolute promises are not allowed.",
        "severity": "critical",
        "source": "Brand Kit - Glossary v1.2",
        "category": "compliance"
      },
      {
        "id": "BAN-012",
        "term": "unverified superlative",
        "patterns": ["\\b[Ff]astest\\b(?: (?:in|of|on) (?:the )?[A-Za-z]+)?", "\\b[Nn]umber one\\b", "\\b[Nn]o\\.? ?1\\b", "\\b[Mm]ost popular\\b", "\\b[Bb]est in (?:the )?(?:world|india|class)\\b"],
        "alternatives": ["helps teams create reports quickly"],
        "reason": "No approved evidence supports this superlative claim.",
        "severity": "warning",
        "source": "Brand Kit - Glossary v1.2",
        "category": "claims"
      }
    ],
